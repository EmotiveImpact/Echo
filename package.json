{
  "name": "hearback",
  "version": "0.1.4",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/EmotiveImpact/Echo.git"
  },
  "homepage": "https://github.com/EmotiveImpact/Echo",
  "author": {
    "name": "Hearback",
    "email": "emotiveimpact@gmail.com"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "build:desktop": "next build && node scripts/build-desktop.mjs",
    "build:extension": "next build && node scripts/build-extension.mjs",
    "desktop": "npm run build:desktop && electron desktop",
    "package:desktop:linux": "npm run build:desktop && electron-builder --projectDir desktop --config electron-builder.yml --linux AppImage",
    "package:desktop:mac": "npm run build:desktop && electron-builder --projectDir desktop --config electron-builder.yml --mac dmg",
    "package:desktop:win": "npm run build:desktop && electron-builder --projectDir desktop --config electron-builder.yml --win nsis",
    "package:vsix": "npm run build:extension && cd extension && vsce package --no-dependencies --allow-missing-repository --out ../artifacts/hearback-0.1.0.vsix",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test lib/*.test.ts",
    "test:extension": "node scripts/test-extension-activation.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "node-edge-tts": "^1.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

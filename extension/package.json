{
  "name": "hearback",
  "displayName": "Hearback for Cursor",
  "description": "Capture Cursor Agent replies and play them aloud beside your chat.",
  "version": "0.1.0",
  "publisher": "hearback",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/EmotiveImpact/Echo.git"
  },
  "homepage": "https://github.com/EmotiveImpact/Echo",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cursor",
    "text-to-speech",
    "accessibility",
    "agent",
    "audio"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:hearback.open",
    "onCommand:hearback.restart"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hearback.open",
        "title": "Hearback: Open Player",
        "icon": "$(unmute)"
      },
      {
        "command": "hearback.restart",
        "title": "Hearback: Restart Local Player"
      }
    ],
    "keybindings": [
      {
        "command": "hearback.open",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      }
    ]
  },
  "scripts": {
    "package": "vsce package --no-dependencies"
  }
}
